<%- include('partials/header') %>

<div class="container">
    <div class="hero" style="padding: 2.5rem 0 1.5rem; text-align:left;">
        <h1 class="hero-title" style="font-size:2rem; margin-bottom:0.5rem;">
            Продажи
        </h1>
        <p class="text-sec">Кабинет продавца: объявления, цены и выставление скинов</p>
    </div>

    <div id="sales-locked" class="access-lock" style="display:none;">
        <div>
            <div class="lock-title">Доступ закрыт</div>
            <p class="text-sec">Раздел доступен продавцу и администратору.</p>
        </div>
        <button class="btn btn-primary" onclick="openLoginModal()">Войти</button>
    </div>

    <div id="sales-dashboard" style="display:none;">
        <div class="role-summary mb-3">
            <div>
                <div class="role-summary-title" id="seller-role-title">-</div>
                <div class="text-sec" id="seller-role-desc">-</div>
            </div>
            <span class="role-chip" id="seller-role-chip">-</span>
        </div>

        <div class="seller-metrics">
            <div class="seller-metric">
                <span>Активные объявления</span>
                <strong id="seller-active-count">0</strong>
            </div>
            <div class="seller-metric">
                <span>Общая сумма</span>
                <strong id="seller-total-price">0 ₽</strong>
            </div>
            <div class="seller-metric">
                <span>Доступно в инвентаре</span>
                <strong id="seller-inventory-count">0</strong>
            </div>
        </div>

        <div class="sales-grid">
            <div class="card">
                <div class="card-title">Новое объявление</div>
                <form class="sales-form" onsubmit="createSellerListing(event)">
                    <div class="form-group">
                        <label class="form-label" for="seller-inventory">Скин из инвентаря</label>
                        <select id="seller-inventory" class="form-control"></select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="seller-price">Цена, ₽</label>
                        <input id="seller-price" class="form-control" type="number" min="1" step="1" placeholder="25000">
                    </div>
                    <button class="btn btn-primary" id="seller-create-button" type="submit">Выставить на продажу</button>
                </form>
            </div>

            <div class="card">
                <div class="card-title">Мои объявления</div>
                <div id="seller-listings" class="table-wrap">
                    <div class="loading"><div class="spinner"></div>Загрузка...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let sellerInventory = [];
let sellerListings = [];

function renderSalesAccess() {
    const session = getCurrentRoleSession();
    const role = getRoleConfig(session.role);
    const canSell = roleCan('sell');

    document.getElementById('sales-locked').style.display = canSell ? 'none' : 'flex';
    document.getElementById('sales-dashboard').style.display = canSell ? 'block' : 'none';

    if (!canSell) return;
    document.getElementById('seller-role-title').textContent = role.title;
    document.getElementById('seller-role-desc').textContent = role.description;
    document.getElementById('seller-role-chip').textContent = role.badge;
    loadSellerData();
}

async function loadSellerData() {
    const session = getCurrentRoleSession();
    try {
        const [listingsResponse, inventoryResponse] = await Promise.all([
            fetch(`/api/seller/${session.userId}/listings`),
            fetch(`/api/seller/${session.userId}/inventory`)
        ]);
        if (!listingsResponse.ok) throw new Error(`HTTP ${listingsResponse.status}`);
        if (!inventoryResponse.ok) throw new Error(`HTTP ${inventoryResponse.status}`);

        sellerListings = await listingsResponse.json();
        sellerInventory = await inventoryResponse.json();
        renderSellerMetrics();
        renderSellerInventory();
        renderSellerListings();
    } catch (error) {
        document.getElementById('seller-listings').innerHTML = errHtml(error);
    }
}

function renderSellerMetrics() {
    const total = sellerListings.reduce((sum, item) => sum + Number(item.Price || 0), 0);
    document.getElementById('seller-active-count').textContent = sellerListings.length;
    document.getElementById('seller-total-price').textContent = fmtMoney(total) + ' ₽';
    document.getElementById('seller-inventory-count').textContent = sellerInventory.length;
}

function renderSellerInventory() {
    const select = document.getElementById('seller-inventory');
    const button = document.getElementById('seller-create-button');
    if (!sellerInventory.length) {
        select.innerHTML = '<option value="">Нет доступных скинов</option>';
        button.disabled = true;
        return;
    }

    select.innerHTML = sellerInventory.map(item => `
        <option value="${esc(item.InventoryID)}">
            ${esc(item.WeaponName || '')} | ${esc(item.SkinName)} (${esc(item.Quality || '—')})
        </option>
    `).join('');
    button.disabled = false;
}

function renderSellerListings() {
    const wrap = document.getElementById('seller-listings');
    if (!sellerListings.length) {
        wrap.innerHTML = '<div class="loading">Активных объявлений пока нет</div>';
        return;
    }

    wrap.innerHTML = `
        <table>
            <thead>
                <tr>
                    <th>Скин</th>
                    <th>Оружие</th>
                    <th>Качество</th>
                    <th>Цена</th>
                    <th>Рынок</th>
                </tr>
            </thead>
            <tbody>
                ${sellerListings.map(item => `
                    <tr>
                        <td class="fw-600 skin-name-cell">${skinPreview(item.ImageURL, item.SkinName)}<span>${esc(item.SkinName)}</span></td>
                        <td class="text-sec">${esc(item.WeaponName || '')}</td>
                        <td>${qualityBadge(item.Quality)}</td>
                        <td class="td-price">${fmtMoney(item.Price)} ₽</td>
                        <td class="${getPriceClass(item.PriceRating)}">${esc(item.PriceRating || 'Market Price')}</td>
                    </tr>
                `).join('')}
            </tbody>
        </table>
    `;
}

async function createSellerListing(event) {
    event.preventDefault();
    if (!roleCan('sell')) {
        openLoginModal();
        showToast('Войдите как продавец или администратор', true);
        return;
    }

    const session = getCurrentRoleSession();
    const inventoryId = document.getElementById('seller-inventory').value;
    const price = Number(document.getElementById('seller-price').value);

    try {
        const response = await fetch('/api/seller/listings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sellerId: session.userId, inventoryId, price })
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
            throw new Error(result.error || 'Не удалось создать объявление');
        }
        document.getElementById('seller-price').value = '';
        showToast(result.message || 'Объявление создано');
        await loadSellerData();
    } catch (error) {
        showToast(error.message, true);
    }
}

document.addEventListener('DOMContentLoaded', renderSalesAccess);
window.addEventListener('cs2-role-changed', renderSalesAccess);
</script>

<%- include('partials/footer') %>
